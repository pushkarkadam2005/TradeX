        {
          "name": "Register Trader  [POST /api/auth/register]",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Register Trader: 201 Created', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                "var j = pm.response.json();",
                "if(j.data && j.data.accessToken){",
                "  pm.collectionVariables.set('jwt_token', j.data.accessToken);",
                "  pm.test('jwt_token saved', function(){ pm.expect(j.data.accessToken).to.not.be.empty; });",
                "}",
                "if(j.data && j.data.user && j.data.user.id){",
                "  pm.collectionVariables.set('user_id', j.data.user.id);",
                "  pm.test('user_id saved', function(){ pm.expect(j.data.user.id).to.not.be.empty; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"trader1@tradex.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Alex Trader\",\n  \"role\": \"ROLE_USER\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "description": "No auth. Creates trader. jwt_token + user_id auto-saved. Returns 409 if email exists (normal)."
          }
        },

