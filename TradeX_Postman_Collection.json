                "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
                "description": "Returns list of all orders. Statuses: PENDING, OPEN, PARTIALLY_FILLED, FILLED, CANCELLED, REJECTED"
