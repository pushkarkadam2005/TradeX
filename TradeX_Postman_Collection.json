{
  "info": {
    "_postman_id": "tradex-backend-api-collection-v3-final",
    "name": "TradeX Financial Platform API",
    "description": "FINAL Postman Collection for TradeX Backend.\nSeparated into: 1. Public & Auth | 2. Trader Endpoints | 3. Admin Endpoints.\nAll tokens and IDs are auto-saved via post-response scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",           "value": "http://localhost:8080", "type": "string" },
    { "key": "jwt_token",         "value": "", "type": "string" },
    { "key": "admin_jwt_token",   "value": "", "type": "string" },
    { "key": "user_id",           "value": "", "type": "string" },
    { "key": "stock_symbol",      "value": "AAPL", "type": "string" },
    { "key": "order_id",          "value": "", "type": "string" },
    { "key": "withdrawal_id",     "value": "", "type": "string" },
    { "key": "kyc_id",            "value": "", "type": "string" },
    { "key": "notification_id",   "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "1. Public & Authentication",
      "item": [

        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api","health"] },
            "description": "No auth required. Verify the server is running."
          }
        },

        {
          "name": "Register Trader User",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Register Trader - status 201', function() {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                "});",
                "var res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "    pm.collectionVariables.set('jwt_token', res.data.accessToken);",
                "    pm.test('Trader jwt_token saved', function() { pm.expect(res.data.accessToken).to.not.be.empty; });",
                "}",
                "if (res.data && res.data.user && res.data.user.id) {",
                "    pm.collectionVariables.set('user_id', res.data.user.id);",
                "    pm.test('Trader user_id saved', function() { pm.expect(res.data.user.id).to.not.be.empty; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trader1@tradex.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Alex Trader\",\n  \"role\": \"ROLE_USER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "description": "Register a new trader. Returns jwt_token + user_id (auto-saved)."
          }
        },

        {
          "name": "Login Trader User",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login Trader - status 200', function() {",
                "    pm.response.to.have.status(200);",
                "});",
                "var res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "    pm.collectionVariables.set('jwt_token', res.data.accessToken);",
                "    pm.test('jwt_token saved', function() { pm.expect(res.data.accessToken).to.not.be.empty; });",
                "}",
                "if (res.data && res.data.user && res.data.user.id) {",
                "    pm.collectionVariables.set('user_id', res.data.user.id);",
                "    pm.test('user_id saved', function() { pm.expect(res.data.user.id).to.not.be.empty; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trader1@tradex.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "description": "Login trader. jwt_token and user_id are auto-saved to collection variables."
          }
        },

        {
          "name": "Register Admin User",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Register Admin - status 201', function() {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
