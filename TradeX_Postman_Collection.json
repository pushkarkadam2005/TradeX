        {
          "name": "Orders",
          "item": [

            {
              "name": "Place LIMIT BUY  [POST /api/orders]",
              "event": [{
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Place LIMIT BUY: 200 or 201', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                    "var j = pm.response.json();",
                    "if(j.data && j.data.id){",
                    "  pm.collectionVariables.set('order_id', j.data.id);",
                    "  pm.test('order_id saved', function(){ pm.expect(j.data.id).to.not.be.empty; });",
                    "}",
                    "pm.test('Side is BUY', function(){ pm.expect(j.data.side).to.eql('BUY'); });",
                    "pm.test('OrderType is LIMIT', function(){ pm.expect(j.data.orderType).to.eql('LIMIT'); });"
                  ]
                }
              }],
              "request": {
                "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}","type":"string"}]},
                "method": "POST",
                "header": [{"key":"Content-Type","value":"application/json"}],
                "body": { "mode": "raw", "raw": "{\n  \"symbol\": \"AAPL\",\n  \"side\": \"BUY\",\n  \"orderType\": \"LIMIT\",\n  \"quantity\": 10,\n  \"limitPrice\": 150.00,\n  \"clientOrderId\": \"limit-buy-001\"\n}" },
                "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
                "description": "Places LIMIT BUY: 10 AAPL @ $150. Locks $1500 from available balance.\nRequired: symbol, side(BUY/SELL), orderType(MARKET/LIMIT), quantity, limitPrice(if LIMIT), clientOrderId\norder_id auto-saved."
              }
            },

            {
              "name": "Place LIMIT SELL  [POST /api/orders]",
              "event": [{
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Place LIMIT SELL: 200 or 201', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                    "var j = pm.response.json();",
                    "pm.test('Side is SELL', function(){ pm.expect(j.data.side).to.eql('SELL'); });",
                    "pm.test('Status is OPEN or FILLED', function(){ pm.expect(j.data.status).to.be.oneOf(['OPEN','FILLED','PARTIALLY_FILLED']); });"
                  ]
                }
              }],
              "request": {
                "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}","type":"string"}]},
                "method": "POST",
                "header": [{"key":"Content-Type","value":"application/json"}],
                "body": { "mode": "raw", "raw": "{\n  \"symbol\": \"AAPL\",\n  \"side\": \"SELL\",\n  \"orderType\": \"LIMIT\",\n  \"quantity\": 5,\n  \"limitPrice\": 150.00,\n  \"clientOrderId\": \"limit-sell-001\"\n}" },
                "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
                "description": "Places LIMIT SELL: 5 AAPL @ $150. Matching engine fires if resting BUY exists at same price.\nNote: Run after LIMIT BUY to see FILLED status."
              }
            },

            {
              "name": "Place MARKET BUY  [POST /api/orders]",
              "request": {
                "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}","type":"string"}]},
                "method": "POST",
                "header": [{"key":"Content-Type","value":"application/json"}],
                "body": { "mode": "raw", "raw": "{\n  \"symbol\": \"AAPL\",\n  \"side\": \"BUY\",\n  \"orderType\": \"MARKET\",\n  \"quantity\": 2,\n  \"clientOrderId\": \"market-buy-001\"\n}" },
                "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
                "description": "MARKET BUY executes immediately against resting SELL orders.\nNote: no limitPrice for MARKET orders."
              }
            },

            {
              "name": "Get My Orders  [GET /api/orders]",
              "request": {
                "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}","type":"string"}]},
                "method": "GET",
