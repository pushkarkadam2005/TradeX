        {
          "name": "KYC Verification",
          "item": [

            {
              "name": "Submit KYC",
              "event": [{
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Submit KYC - status 200', function() { pm.response.to.have.status(200); });",
                    "var res = pm.response.json();",
                    "if (res.data && res.data.id) {",
                    "    pm.collectionVariables.set('kyc_id', res.data.id);",
                    "    pm.test('kyc_id saved', function() { pm.expect(res.data.id).to.not.be.empty; });",
                    "}",
                    "pm.test('KYC status is PENDING', function() {",
                    "    pm.expect(res.data.status).to.eql('PENDING');",
                    "});"
                  ]
                }
              }],
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
