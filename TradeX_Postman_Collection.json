            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@tradex.com\",\n  \"password\": \"AdminPass123!\",\n  \"fullName\": \"System Admin\",\n  \"role\": \"ROLE_ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "description": "Register admin user. admin_jwt_token auto-saved."
          }
        },

        {
          "name": "Login Admin User",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login Admin - status 200', function() {",
                "    pm.response.to.have.status(200);",
                "});",
                "var res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "    pm.collectionVariables.set('admin_jwt_token', res.data.accessToken);",
                "    pm.test('admin_jwt_token saved', function() { pm.expect(res.data.accessToken).to.not.be.empty; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@tradex.com\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "description": "Login admin. admin_jwt_token auto-saved."
          }
        }

      ]
    },

