        {
          "name": "Order Management & Matching",
          "item": [

            {
              "name": "Place LIMIT BUY Order",
              "event": [{
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Place LIMIT BUY - status 200 or 201', function() {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "var res = pm.response.json();",
                    "if (res.data && res.data.id) {",
                    "    pm.collectionVariables.set('order_id', res.data.id);",
                    "    pm.test('order_id saved', function() { pm.expect(res.data.id).to.not.be.empty; });",
                    "}"
                  ]
                }
              }],
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"symbol\": \"AAPL\",\n  \"side\": \"BUY\",\n  \"orderType\": \"LIMIT\",\n  \"quantity\": 10,\n  \"limitPrice\": 150.00,\n  \"clientOrderId\": \"limit-buy-001\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
                "description": "Places a LIMIT BUY order. Locks $1500 from available balance. order_id auto-saved."
              }
            },

            {
              "name": "Place LIMIT SELL Order",
              "event": [{
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Place LIMIT SELL - status 200 or 201', function() {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "var res = pm.response.json();",
                    "pm.test('Sell order side is SELL', function() {",
                    "    pm.expect(res.data.side).to.eql('SELL');",
                    "});"
                  ]
                }
              }],
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"symbol\": \"AAPL\",\n  \"side\": \"SELL\",\n  \"orderType\": \"LIMIT\",\n  \"quantity\": 5,\n  \"limitPrice\": 150.00,\n  \"clientOrderId\": \"limit-sell-001\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
                "description": "Places a LIMIT SELL. Matching engine instantly fills against resting BUY at same price."
              }
            },

